!> Slow 3D MPI integration test: runs the full CLARA 17-module lattice
!! (17 undulators × 29 periods × 30 steps = 14790 steps) with 2 MPI processes
!! and validates output against pre-generated golden reference files.
!!
!! This test is gated by the CMake option PUFFIN_SLOW_TESTS=ON and takes
!! several minutes to complete.
!!
!! Before this test can pass you must complete a one-off golden run:
!!
!!   1. Build puffin and run:
!!        mpiexec -n 2 <build>/puffin inputs/3D/clara_full.in
!!      (from build/test/ so CWD-relative paths resolve correctly)
!!
!!   2. Identify the final step index N from the output filenames
!!      (clara_full_aperp_N.h5, etc.) — expected ~246 given iWriteNthSteps=60.
!!      Set CLARA_FULL_FINAL_STEP below to that value.
!!
!!   3. Copy the final outputs:
!!        clara_full_aperp_N.h5      -> test/expected/3D/clara_full_expected_field.h5
!!        clara_full_electrons_N.h5  -> test/expected/3D/clara_full_expected_electrons.h5
!!        clara_full_integrated_N.h5 -> test/expected/3D/clara_full_expected_integrated.h5
!!
!!   4. Re-run cmake to pick up the new expected files, then rebuild and retest.

module testMPIIntegration3DSlow

  use pFUnit
  use MPI
  use puffin_kinds
  use puffin_mod, only: puffin_main
  use H5in, only: getMacroparticleCount, readH5BeamDataOntoRootProcess, &
                  getNX, getNY, getNZ2, readH5FieldDataOntoRootProcess3D
  use globals
  use puffin_mpiInfo, only: tProcInfo_G
  implicit none

  ! Final step index from the golden simulation run (verified from output filenames).
  integer(kind=ip), parameter :: CLARA_FULL_FINAL_STEP = 99_ip

  character(len=1024_IP) :: test_file_1    = 'inputs/3D/clara_full.in'
  character(len=1024_ip) :: output_file_base = 'inputs/3D/clara_full'

contains

  @mpitest(npes=[2])
  subroutine testPuffinSimulationCompletes3DFull(this)

    class(MpiTestMethod), intent(inout) :: this
    logical :: file_exists, qOK
    character(len=1024_ip) :: test_output_field_initial_file, &
                              test_output_electron_initial_file, &
                              test_output_integrated_initial_file, &
                              test_output_field_final_file, &
                              test_output_electron_final_file, &
                              test_output_integrated_final_file, &
                              expected_field_file, &
                              expected_electron_file, &
                              expected_integrated_file, &
                              step_str
    integer(kind=ip) :: nMPs, i
    real(kind=WP), allocatable :: sElX(:), sElY(:), sElZ2(:), sElPX(:), sElPY(:), sElGam(:), chi_bar(:)
    integer(kind=ip) :: nX, nY, nZ2nodes, nField
    integer(kind=ip) :: expected_nX, expected_nY, expected_nZ2
    real(kind=WP), allocatable :: rfield(:), ifield(:), expected_rfield(:), expected_ifield(:)
    real(kind=WP), allocatable :: expected_sElX(:), expected_sElY(:), expected_sElZ2(:)
    real(kind=WP), allocatable :: expected_sElPX(:), expected_sElPY(:), expected_sElGam(:)
    real(kind=WP), allocatable :: expected_chi_bar(:)

    print *, 'Testing full-lattice 3D Puffin simulation completion (CLARA 17-module)...'

    call puffin_main(test_file_1, qOK)

    write(step_str, '(i0)') CLARA_FULL_FINAL_STEP

    test_output_field_initial_file      = trim(output_file_base) // '_aperp_0.h5'
    test_output_electron_initial_file   = trim(output_file_base) // '_electrons_0.h5'
    test_output_integrated_initial_file = trim(output_file_base) // '_integrated_0.h5'

    test_output_field_final_file    = trim(output_file_base) // '_aperp_'     // trim(step_str) // '.h5'
    test_output_electron_final_file = trim(output_file_base) // '_electrons_' // trim(step_str) // '.h5'
    test_output_integrated_final_file = trim(output_file_base) // '_integrated_' // trim(step_str) // '.h5'

    expected_field_file      = 'expected/3D/clara_full_expected_field.h5'
    expected_electron_file   = 'expected/3D/clara_full_expected_electrons.h5'
    expected_integrated_file = 'expected/3D/clara_full_expected_integrated.h5'

    inquire(file=test_output_field_initial_file, exist=file_exists)
    @AssertTrue(file_exists)

    inquire(file=test_output_electron_initial_file, exist=file_exists)
    @AssertEqual(file_exists, .true.)

    inquire(file=test_output_integrated_initial_file, exist=file_exists)
    @AssertEqual(file_exists, .true.)

    inquire(file=test_output_field_final_file, exist=file_exists)
    @AssertEqual(file_exists, .true.)

    inquire(file=test_output_electron_final_file, exist=file_exists)
    @AssertEqual(file_exists, .true.)

    inquire(file=test_output_integrated_final_file, exist=file_exists)
    @AssertEqual(file_exists, .true.)

    ! --- Electron macroparticle comparison ---

    nMPs = getMacroparticleCount(trim(test_output_electron_final_file))
    if (.not. tProcInfo_G%qRoot) nMPs = 0

    allocate(sElX(nMPs), sElY(nMPs), sElZ2(nMPs), sElPX(nMPs), sElPY(nMPs), &
             sElGam(nMPs), chi_bar(nMPs))
    allocate(expected_sElX(nMPs), expected_sElY(nMPs), expected_sElZ2(nMPs), &
             expected_sElPX(nMPs), expected_sElPY(nMPs), expected_sElGam(nMPs), &
             expected_chi_bar(nMPs))

    call readH5BeamDataOntoRootProcess(trim(test_output_electron_final_file), &
      sElX, sElY, sElZ2, sElPX, sElPY, sElGam, chi_bar, nMPs)
    call readH5BeamDataOntoRootProcess(trim(expected_electron_file), &
      expected_sElX, expected_sElY, expected_sElZ2, &
      expected_sElPX, expected_sElPY, expected_sElGam, expected_chi_bar, nMPs)

    ! Running with different numbers of processes can lead to macroparticles being
    ! ordered differently, so check each expected value matches at least one output value.
    if (tProcInfo_G%qroot) then
      do i = 1, nMPs
        @AssertTrue(ANY( ABS(expected_sElX   - sElX(i))   <= 1e-10_WP))
        @AssertTrue(ANY( ABS(expected_sElY   - sElY(i))   <= 1e-10_WP))
        @AssertTrue(ANY( ABS(expected_sElZ2  - sElZ2(i))  <= 1e-10_WP))
        @AssertTrue(ANY( ABS(expected_sElPX  - sElPX(i))  <= 1e-10_WP))
        @AssertTrue(ANY( ABS(expected_sElPY  - sElPY(i))  <= 1e-10_WP))
        @AssertTrue(ANY( ABS(expected_sElGam - sElGam(i)) <= 1e-10_WP))
      end do
    end if

    ! --- 3D radiation field comparison ---

    expected_nX  = getNX(trim(expected_field_file))
    expected_nY  = getNY(trim(expected_field_file))
    expected_nZ2 = getNZ2(trim(expected_field_file))

    nX       = getNX(trim(test_output_field_final_file))
    nY       = getNY(trim(test_output_field_final_file))
    nZ2nodes = getNZ2(trim(test_output_field_final_file))

    if (tProcInfo_G%qroot) then
      print *, 'Field mesh (nX, nY, nZ2):', nX, nY, nZ2nodes
      @AssertEqual(nX,       expected_nX)
      @AssertEqual(nY,       expected_nY)
      @AssertEqual(nZ2nodes, expected_nZ2)
    end if

    nField = nX * nY * nZ2nodes

    allocate(rfield(nField), ifield(nField), &
             expected_rfield(nField), expected_ifield(nField))

    call readH5FieldDataOntoRootProcess3D(trim(test_output_field_final_file), &
      rfield, ifield, nX, nY, nZ2nodes)
    call readH5FieldDataOntoRootProcess3D(trim(expected_field_file), &
      expected_rfield, expected_ifield, expected_nX, expected_nY, expected_nZ2)

    if (tProcInfo_G%qroot) then
      @AssertEqual(rfield, expected_rfield, 1e-10_WP)
      @AssertEqual(ifield, expected_ifield, 1e-10_WP)
    end if

  end subroutine testPuffinSimulationCompletes3DFull

end module testMPIIntegration3DSlow
