! Beam file for the big 3D integration test (shcse_big.in).
!
! Taken verbatim from inputs/simple/3D/shortCSE/beam_file.in — a single matched
! beam, sampled 7x7x400x7x7x7 = 6.72M macroparticles, of which ~378k survive the
! charge threshold and are written out.

&NBLIST
nbeams = 1
dtype = 'simple'
/

&BLIST
sSigmaE =1.0, 1.0, 0.222, 1.0, 1.0, 0.001
sLenE = 1E-6, 1E-6, 2.0, 1E-6, 1E-6, 0.006
iNumMPs = 7, 7, 400, 7, 7, 7
emitx = 1.0
emity = 1.0
sQe = 3.5908E-11
bcenter = 0.0
gammaf = 1.0
qRndEj_G = .false.
sSigEj_G = 0.06
qMatched_A = .true.
TrLdMeth = 2
/
