!!!!!!!!!!!!!!  CLARA input deck  !!!!!!!!!!!!!!
!!
!!  233MeV beam,  lasing @ 100nm
!!  3D single-slice: no lattice file so nPeriods/stepsPerPeriod are used,
!!  keeping the test run short (5 periods x 30 steps = 150 steps).
!!  beam_file_h5.in reads a pre-generated HDF5 beam to ensure determinism.
!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

&MDATA
 qScaled                = .false.
 qOneD                  = .false.
 qFieldEvolve           = .true.
 qElectronsEvolve       = .true.
 qElectronFieldCoupling = .true.
 qFocussing             = .false.
 qDiffraction           = .true.
 qUndEnds = .true.
 qFMesh_G = .false.
 beam_file              = 'inputs/3D/beam_file_h5.in'
 meshType = 1
 sElectronThreshold     = 0.05
 iNumNodesX             = 85
 iNumNodesY             = 85
 nodesPerLambdar        = 21
 sFModelLengthX         = 0.003335537906783215
 sFModelLengthY         = 0.003335537906783215
 sFModelLengthZ2        = 3.329781820520314e-16
 meshType = 1
 sperwaves = 1.0
 iRedNodesX             = 21
 iRedNodesY             = 21
 sFiltFrac              = 0.3
 sDiffFrac              = 1.0
 sBeta                  = 1.0
 seed_file              = 'inputs/3D/seed_file.in'
 srho                   = 0.005
 saw                    = 1.0121809
 sgamma_r               = 456.40
 lambda_w               = 0.0275
 zundType               = 'planepole'
 stepsPerPeriod         = 30
 nPeriods               = 5
 sZ0                    = 0.0
 iWriteNthSteps         = 60
 iWriteIntNthSteps      = 30
 sRedistLen = 0.25
 iRedistStp = 10
 /
