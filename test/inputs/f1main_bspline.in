!
! The f1main deck - Opt Comm fig 1 short flat-top, shortened wiggler - run with
! cubic B-spline deposition instead of the default linear.
!
! Its own beam file, because the beam has to start a few nodes into the mesh: a
! stencil wider than the linear one reaches a node behind the particle. The
! stock beam_file.in leaves bcenter at 0, which getOffsets turns into a beam
! front exactly on z2 = 0.

&MDATA
 qOneD                  = .true.
 iShapeOrder            = 3
 beam_file              = 'inputs/beam_file_bspline.in'
 seed_file = 'inputs/seed_file.in'
 q_noise = .false.
 sElectronThreshold     = 0.05
 nodesPerLambdar        = 17
 sFModelLengthZ2        = 4.0
 srho                   = 0.01
 sux                    = 1.0
 suy                    = 1.0
 saw                    = 1.0
 sgamma_r               = 100.0
 lambda_w               = 0.04
 taper                  = 0.0
 lattFile               = ''
 stepsPerPeriod         = 30
 nPeriods               = 1
 iWriteNthSteps         = 100
 iWriteIntNthSteps      = 100
 /

