!> Unit tests for the period-averaged (SVEA) mode - see averaging.f90.
!!
!! Two kinds of test.
!!
!! The first checks the averaging itself against brute force.  A single
!! electron's exact quiver motion is followed over one undulator period, with
!! p2 from the unaveraged getP2 so that the planar figure-of-eight excursion in
!! z2 is included, and the period average of its coupling to the field - in
!! the field source and in the energy equation - is compared with what the
!! averaged model puts in its place, for each Cartesian field component.  That
!! pins down the Bessel factors, the polarisation amplitudes and the carrier
!! sign independently of the solver, for any undulator polarisation.
!!
!! The second calls getrhs in averaged mode and checks that beam plus field
!! energy is conserved to round-off in a single RHS evaluation.  The source and
!! the energy equation share one coupling array per field component by
!! construction; this is the guard that stops them drifting apart (a
!! mismatched JJ, alpha or phase factor between getSource_1D and dgamdz_f
!! leaks energy while looking perfectly plausible).
!!
!! Both kinds are run for the odd-harmonic bands as well, which brute force
!! checks by projecting onto exp(+i h z2/2rho) instead.
!!
!! No MPI.

module testAveraging

  use pFUnit
  use puffin_kinds
  use puffin_constants, only: pi
  use GlobalTypes, only: tUndulator, tFELFrame, tSimulationContext
  use averaging, only: tAvgCoupling, getAvgUndAmps, getAvgPolarisation, &
                       getAvgEnvelope, getAvgCoupling, avgJJ, avgJJh, getResonantMomentum, &
                       tAvgFocusing, getAvgFocusCoef, getAvgFocusing, getAvgCarrierKz2, &
                       getAvgBands
  use gtop2, only: getP2, getP2Avg

  implicit none

contains

  !> A frame and undulator loosely modelled on the 1D CLARA deck.  eta is set
  !! so that a Gamma = 1 particle is exactly resonant (p2 = 1) in the averaged
  !! model for this polarisation.
  subroutine makeUnd(und, frame, undType, fx, fy)
    type(tUndulator), intent(out) :: und
    type(tFELFrame), intent(out) :: frame
    character(*), intent(in) :: undType
    real(kind=wp), intent(in) :: fx, fy

    real(kind=wp) :: cx, cy, uMinus, uPlus, fp

    frame%rho = 0.005_wp
    frame%aw = 1.0121809_wp
    frame%gamma_ref = 456.40_wp
    frame%kappa = frame%aw / (2.0_wp * frame%rho * frame%gamma_ref)

    und%undulator_type = undType
    und%fx = fx
    und%fy = fy
    und%model_undulator_ends = .false.
    und%z_start_undulator = 0.0_wp
    und%z_end_undulator = 100.0_wp
    und%n2col = 1.0_wp
    und%n2col_initial = 1.0_wp
    und%undulator_gradient = 0.0_wp
    und%z_taper_start = 0.0_wp

    call getAvgUndAmps(undType, fx, fy, cx, cy)
    call getAvgPolarisation(cx, cy, uMinus, uPlus, fp)

    frame%eta = 1.0_wp / sqrt(1.0_wp - (1.0_wp + frame%aw**2 * fp) &
                                        / frame%gamma_ref**2) - 1.0_wp

!   As calcScaling sets them: off-axis wavenumbers only for the curved pole,
!   split evenly between the planes, and no strong-focusing channel.

    und%kx_undulator = 0.0_wp
    und%ky_undulator = 0.0_wp

    if (undType == "curved") then
      und%kx_undulator = sqrt(frame%eta / (8.0_wp * frame%rho**2))
      und%ky_undulator = und%kx_undulator
    end if

    und%k_beta_x_sf = 0.0_wp
    und%k_beta_y_sf = 0.0_wp

  end subroutine makeUnd


  !> The betatron wavenumbers squared that the averaged focusing coefficients
  !! imply for a reference particle, Gamma = 1 and (1 + eta p2) = 1.  From
  !! dx/dz = C spr and dy/dz = -C spi with C = 2 rho kappa (1 + eta p2)/
  !! (sqrt(eta) Gamma), d2x/dz2 = -C cNatX x and d2y/dz2 = -C cNatY y.
  subroutine kBetaSqFromFocus(und, frame, qFocusing, kbxSq, kbySq)
    type(tUndulator), intent(in) :: und
    type(tFELFrame), intent(in) :: frame
    logical, intent(in) :: qFocusing
    real(kind=wp), intent(out) :: kbxSq, kbySq

    type(tAvgFocusing) :: foc
    real(kind=wp) :: cRef

    call getAvgFocusCoef(0.5_wp, und, frame, qFocusing, foc)

    cRef = 2.0_wp * frame%rho * frame%kappa / sqrt(frame%eta)

    kbxSq = cRef * (foc%cNatX + foc%cSFX)
    kbySq = cRef * (foc%cNatY + foc%cSFY)

  end subroutine kBetaSqFromFocus


  !> Trapezoidal average of f over the grid.
  complex(kind=wp) function avgC(f)
    complex(kind=wp), intent(in) :: f(0:)
    integer :: n
    n = ubound(f, 1)
    avgC = (sum(f) - 0.5_wp * (f(0) + f(n))) / real(n, kind=wp)
  end function avgC


  !> Windowed average of f over the grid, weight sin^4(pi i/n).  Off
  !! resonance the fast terms do not complete a whole number of cycles in any
  !! fixed length, so a plain average leaks them in at O(1 - p2); the window's
  !! sidelobes fall off fast enough that over several periods they vanish.
  !! Brute force and model are averaged with the same weights, so the slow
  !! drift of theta is common to both.
  complex(kind=wp) function avgW(f)
    complex(kind=wp), intent(in) :: f(0:)
    real(kind=wp), allocatable :: wt(:)
    integer :: n, i
    n = ubound(f, 1)
    allocate(wt(0:n))
    do i = 0, n
      wt(i) = sin(pi * real(i, kind=wp) / real(n, kind=wp))**4
    end do
    avgW = sum(wt * f) / sum(wt)
  end function avgW


  !> Period averages of the exact coupling, by brute force, and the averaged
  !! model's prediction for the same quantities, per Cartesian component, for
  !! the band at harmonic h = iH.
  !!
  !! srcX, srcY = sqrt(2) < w p_c exp(+i h z2/2rho) >, the drive of the stored
  !!              envelope B_c of A_c = sqrt(2) Re[B_c exp(-i h z2/2rho)]
  !!              (w = (1 + eta p2)/Gamma)
  !! eng        = < w (p_x A_x + p_y A_y) > = < w Re(pperp conj(A_perp)) >, the
  !!              energy-equation coupling, for the field built from Bx, By
  !!
  !! The model side calls getResonantMomentum itself, so the solver's own
  !! q_x, q_y - phase, sign and Bessel factors - are what is being checked.
  !! At h = 1 that is the fundamental's own path, with no band list, and
  !! otherwise the band's columns of a [1, h] layout.
  subroutine bruteForce(und, frame, gam, iH, Bx, By, &
                        srcX, srcY, eng, &
                        srcXM, srcYM, engM, p2Mean, p2Model)
    type(tUndulator), intent(in) :: und
    type(tFELFrame), intent(in) :: frame
    real(kind=wp), intent(in) :: gam
    integer(kind=ip), intent(in) :: iH
    complex(kind=wp), intent(in) :: Bx, By
    complex(kind=wp), intent(out) :: srcX, srcY, srcXM, srcYM
    real(kind=wp), intent(out) :: eng, engM, p2Mean, p2Model

    integer, parameter :: nPer = 8, n = 4000 * nPer
    real(kind=wp), parameter :: z0 = 0.3_wp, z2start = 1.7_wp
    real(kind=wp), allocatable, dimension(:) :: z, px, py, g, p2, z2, zc, w, ax, ay
    complex(kind=wp), allocatable, dimension(:) :: qx, qy, f
    real(kind=wp) :: cx, cy, lamw, h, inv2rho, centre
    type(tAvgCoupling) :: cpl
    real(kind=wp) :: wbar, p2m(1), gm(1), zero(1), zc1(1), hr
    real(kind=wp) :: qr(1,4), qi(1,4)
    complex(kind=wp), parameter :: iu = (0.0_wp, 1.0_wp)
    integer :: i, icx

    allocate(z(0:n), px(0:n), py(0:n), g(0:n), p2(0:n), z2(0:n), zc(0:n), w(0:n))
    allocate(ax(0:n), ay(0:n), qx(0:n), qy(0:n), f(0:n))

    call getAvgUndAmps(und%undulator_type, und%fx, und%fy, cx, cy)

    lamw = 4.0_wp * pi * frame%rho
    h = nPer * lamw / real(n, kind=wp)
    inv2rho = 1.0_wp / (2.0_wp * frame%rho)

    do i = 0, n
      z(i) = z0 + real(i, kind=wp) * h
    end do

!   Exact quiver, physical components: px = -alpha cy cos(zbar/2rho),
!   py = -alpha cx sin(zbar/2rho).  getP2 takes spr = px, spi = -py.

    px = -und%n2col * cy * cos(z * inv2rho)
    py = -und%n2col * cx * sin(z * inv2rho)
    g = gam

    call getP2(p2, g, px, -py, frame%eta, frame%gamma_ref, frame%aw)

!   z2 by trapezoidal integration of p2, then its guiding centre: the linear
!   trend through the period mean, which is what the averaged model tracks.

    z2(0) = z2start
    do i = 1, n
      z2(i) = z2(i-1) + 0.5_wp * h * (p2(i-1) + p2(i))
    end do

!   The z2 ripple is exactly periodic over whole undulator periods, so a plain
!   average finds the guiding centre

    p2Mean = (z2(n) - z2(0)) / (nPer * lamw)
    centre = real(avgC(cmplx(z2 - p2Mean * (z - z0), 0.0_wp, kind=wp)), kind=wp)
    zc = centre + p2Mean * (z - z0)

    w = (1.0_wp + frame%eta * p2) / g

!   The physical field seen at the particle's true position

    hr = real(iH, kind=wp)

    ax = sqrt(2.0_wp) * real(Bx * exp(-iu * hr * z2 * inv2rho), kind=wp)
    ay = sqrt(2.0_wp) * real(By * exp(-iu * hr * z2 * inv2rho), kind=wp)

    f = sqrt(2.0_wp) * w * px * exp(iu * hr * z2 * inv2rho)
    srcX = avgW(f)
    f = sqrt(2.0_wp) * w * py * exp(iu * hr * z2 * inv2rho)
    srcY = avgW(f)
    f = cmplx(w * (px * ax + py * ay), 0.0_wp, kind=wp)
    eng = real(avgW(f), kind=wp)

!   The averaged model, with p2 and w from the period-averaged |pperp|^2 and
!   q_x, q_y from the solver's own routine at each zbar along the guiding centre

    call getAvgCoupling(z0, und, frame, cpl)

    gm = gam
    zero = 0.0_wp
    call getP2Avg(p2m, gm, zero, zero, frame%eta, frame%gamma_ref, frame%aw, cpl%pqSq)
    p2Model = p2m(1)
    wbar = (1.0_wp + frame%eta * p2Model) / gam

    icx = 1
    if (iH > 1_ip) icx = 3

    do i = 0, n
      zc1 = zc(i)
      if (iH == 1_ip) then
        call getResonantMomentum(z(i), zc1, gm, p2m, frame%eta, frame%rho, cpl, &
                                 qr(:,1:2), qi(:,1:2))
      else
        call getResonantMomentum(z(i), zc1, gm, p2m, frame%eta, frame%rho, cpl, &
                                 qr, qi, [1_ip, iH])
      end if
      qx(i) = cmplx(qr(1,icx), qi(1,icx), kind=wp)
      qy(i) = cmplx(qr(1,icx+1), qi(1,icx+1), kind=wp)
    end do

    srcXM = wbar * avgW(qx)
    srcYM = wbar * avgW(qy)
    f = cmplx(wbar * real(qx * conjg(Bx) + qy * conjg(By), kind=wp), 0.0_wp, kind=wp)
    engM = real(avgW(f), kind=wp)

  end subroutine bruteForce


  !> Compare brute force and model for one undulator and energy, at harmonic
  !! h (1 if absent).  The model drops the O(eta) ripple in (1 + eta p2), so
  !! 1e-5 relative is as close as it can be expected to get; any error in a
  !! Bessel factor, an amplitude or the carrier sign is O(1e-1) or O(1).  The
  !! two field components are deliberately unrelated, so the energy check
  !! sees both couplings at once.
  !!
  !! The scale is the fundamental's, so a harmonic coupling that should vanish
  !! (any harmonic of a helical undulator) is checked to be small against what
  !! the fundamental would be, rather than against itself.
  subroutine checkAgainstBruteForce(undType, fx, fy, gam, h)
    character(*), intent(in) :: undType
    real(kind=wp), intent(in) :: fx, fy, gam
    integer(kind=ip), intent(in), optional :: h

    type(tUndulator) :: und
    type(tFELFrame) :: frame
    complex(kind=wp) :: srcX, srcY, srcXM, srcYM, s1x, s1y, s1xM, s1yM
    real(kind=wp) :: eng, engM, p2Mean, p2Model, scale, e1, e1M
    complex(kind=wp), parameter :: Bx = (0.3_wp, 0.7_wp), By = (-0.5_wp, 0.2_wp)
    real(kind=wp), parameter :: tol = 1.0e-5_wp
    integer(kind=ip) :: hh

    hh = 1_ip
    if (present(h)) hh = h

    call makeUnd(und, frame, undType, fx, fy)
    call bruteForce(und, frame, gam, 1_ip, Bx, By, s1x, s1y, e1, &
                    s1xM, s1yM, e1M, p2Mean, p2Model)

    scale = max(abs(s1xM), abs(s1yM))

    if (hh == 1_ip) then
      srcX = s1x; srcY = s1y; eng = e1
      srcXM = s1xM; srcYM = s1yM; engM = e1M
    else
      call bruteForce(und, frame, gam, hh, Bx, By, srcX, srcY, eng, &
                      srcXM, srcYM, engM, p2Mean, p2Model)
    end if

    @assertEqual(real(srcXM, kind=wp), real(srcX, kind=wp), tol * scale)
    @assertEqual(aimag(srcXM), aimag(srcX), tol * scale)
    @assertEqual(real(srcYM, kind=wp), real(srcY, kind=wp), tol * scale)
    @assertEqual(aimag(srcYM), aimag(srcY), tol * scale)
    @assertEqual(engM, eng, tol * scale * max(abs(Bx), abs(By)))

!   Period-averaged p2 against the true mean velocity.  They differ at second
!   order in the |pperp|^2 ripple, ~1e-7 here - far below the rho = 5e-3
!   scale on which it would detune the interaction.

    @assertEqual(p2Mean, p2Model, 1.0e-5_wp)

  end subroutine checkAgainstBruteForce


  !> The limits the Cartesian couplings must reduce to.  Planar drives x alone,
  !! with the single-envelope amplitude alpha sqrt(fp); helical drives y a
  !! quarter period ahead of x, exactly, which used to be imposed by slaving
  !! component 2 and now has to come out of the equations; linear along y
  !! mirrors planar, which needs xi to keep its sign; and in the helicity basis
  !! an elliptical undulator gives the old alpha (u- J0 - u+ J1) on the
  !! resonant helicity.
  @test
  subroutine testCartesianLimits()
    type(tUndulator) :: und
    type(tFELFrame) :: frame
    type(tAvgCoupling) :: cplP, cplV, cpl
    real(kind=wp), dimension(3) :: sz2, sgam, sp2
    real(kind=wp) :: qr(3,2), qi(3,2)
    real(kind=wp) :: jxP, jyP, jxV, jyV, cx, cy, uMinus, uPlus, fp, xi, theta
    complex(kind=wp) :: qMinus, expect
    complex(kind=wp), parameter :: iu = (0.0_wp, 1.0_wp)
    integer :: j

    sz2 = [0.11_wp, 0.52_wp, 0.93_wp]
    sgam = [1.0_wp, 1.003_wp, 0.996_wp]

!   Planar: x alone, at the single-envelope amplitude

    call makeUnd(und, frame, "planepole", 1.0_wp, 1.0_wp)
    call getAvgCoupling(0.4_wp, und, frame, cplP)
    @assertEqual(0.0_wp, cplP%ampY, 0.0_wp)
    @assertEqual(sqrt(0.5_wp), cplP%ampX, 0.0_wp)

    sp2 = 1.0_wp
    call getResonantMomentum(0.4_wp, sz2, sgam, sp2, frame%eta, frame%rho, cplP, qr, qi)
    @assertEqual(0.0_wp, maxval(abs(qr(:,2))), 0.0_wp)
    @assertEqual(0.0_wp, maxval(abs(qi(:,2))), 0.0_wp)

!   Helical: q_y = i q_x exactly - Re q_y = -Im q_x, Im q_y = Re q_x

    call makeUnd(und, frame, "helical", 1.0_wp, 1.0_wp)
    call getAvgCoupling(0.4_wp, und, frame, cpl)
    call getResonantMomentum(0.4_wp, sz2, sgam, sp2, frame%eta, frame%rho, cpl, qr, qi)
    @assertEqual(0.0_wp, maxval(abs(qr(:,2) + qi(:,1))), 0.0_wp)
    @assertEqual(0.0_wp, maxval(abs(qi(:,2) - qr(:,1))), 0.0_wp)
    @assertTrue(maxval(abs(qr(:,1))) > 0.1_wp)

!   Linear along y: drives y alone, with planar's J0 - J1 at the same |xi|

    call makeUnd(und, frame, "", 1.0_wp, 0.0_wp)
    call getAvgCoupling(0.4_wp, und, frame, cplV)
    @assertEqual(0.0_wp, cplV%ampX, 0.0_wp)
    @assertEqual(sqrt(0.5_wp), cplV%ampY, 0.0_wp)
    @assertEqual(-cplP%xiCoef, cplV%xiCoef, 0.0_wp)

    call avgJJ(cplP, 1.02_wp, 0.99_wp, jxP, jyP)
    call avgJJ(cplV, 1.02_wp, 0.99_wp, jxV, jyV)
    @assertEqual(jxP, jyV, 1.0e-15_wp)
    @assertEqual(jyP, jxV, 1.0e-15_wp)
    @assertTrue(abs(jxP - 1.0_wp) > 0.05_wp)

!   Elliptical, in the helicity basis: (q_x - i q_y)/sqrt(2) is the resonant
!   helicity's coupling, -alpha (u- J0 - u+ J1) exp(-i theta)

    call makeUnd(und, frame, "", 0.5_wp, 1.0_wp)
    call getAvgCoupling(0.4_wp, und, frame, cpl)
    call getAvgUndAmps("", 0.5_wp, 1.0_wp, cx, cy)
    call getAvgPolarisation(cx, cy, uMinus, uPlus, fp)

    sp2 = [1.0_wp, 0.98_wp, 1.01_wp]
    call getResonantMomentum(0.4_wp, sz2, sgam, sp2, frame%eta, frame%rho, cpl, qr, qi)

    do j = 1, 3
      xi = cpl%xiCoef * (1.0_wp + frame%eta * sp2(j))**3 / sgam(j)**2
      theta = (0.4_wp - sz2(j)) / (2.0_wp * frame%rho)
      expect = -(uMinus * bessel_j0(xi) - uPlus * bessel_j1(xi)) * exp(-iu * theta)
      qMinus = (cmplx(qr(j,1), qi(j,1), kind=wp) - iu * cmplx(qr(j,2), qi(j,2), kind=wp)) &
               / sqrt(2.0_wp)
      @assertEqual(real(expect, kind=wp), real(qMinus, kind=wp), 1.0e-14_wp)
      @assertEqual(aimag(expect), aimag(qMinus), 1.0e-14_wp)
    end do

  end subroutine testCartesianLimits


  @test
  subroutine testHelicalMatchesBruteForce()
    call checkAgainstBruteForce("helical", 1.0_wp, 1.0_wp, 1.0_wp)
    call checkAgainstBruteForce("helical", 1.0_wp, 1.0_wp, 1.004_wp)
  end subroutine testHelicalMatchesBruteForce


  @test
  subroutine testPlanepoleMatchesBruteForce()
    call checkAgainstBruteForce("planepole", 1.0_wp, 1.0_wp, 1.0_wp)
    call checkAgainstBruteForce("planepole", 1.0_wp, 1.0_wp, 0.996_wp)
  end subroutine testPlanepoleMatchesBruteForce


  !> Linearly polarised along y, through the variably-polarised default type:
  !! u+ = -u-, and the figure-of-eight has the opposite sign.
  @test
  subroutine testVerticalPlanarMatchesBruteForce()
    call checkAgainstBruteForce("", 1.0_wp, 0.0_wp, 1.0_wp)
    call checkAgainstBruteForce("", 1.0_wp, 0.0_wp, 1.004_wp)
  end subroutine testVerticalPlanarMatchesBruteForce


  !> Genuinely elliptical undulators, which a single envelope could not carry:
  !! the two components have different Bessel factors and amplitudes, and the
  !! figure-of-eight is weaker than planar but nonzero, of either sign.
  @test
  subroutine testEllipticalMatchesBruteForce()
    call checkAgainstBruteForce("", 0.5_wp, 1.0_wp, 1.0_wp)
    call checkAgainstBruteForce("", 0.5_wp, 1.0_wp, 0.996_wp)
    call checkAgainstBruteForce("", 1.0_wp, 0.6_wp, 1.0_wp)
    call checkAgainstBruteForce("", 1.0_wp, 0.6_wp, 1.004_wp)
  end subroutine testEllipticalMatchesBruteForce


  !> The opposite helicity, cx = -cy: resonant with the exp(+i z2/2rho) image
  !! in the old helicity basis, and so impossible for one envelope.  In the
  !! Cartesian basis it is just q_y = -i q_x.
  @test
  subroutine testOppositeHelicityMatchesBruteForce()
    call checkAgainstBruteForce("", -1.0_wp, 1.0_wp, 1.0_wp)
  end subroutine testOppositeHelicityMatchesBruteForce


  !> The odd-harmonic bands, h = 3 and 5, against the same brute force
  !! projected onto exp(+i h z2/2rho).  Planar and linear-along-y drive one
  !! component each, through (-1)^m [J_m(h xi) -+ J_(m+1)(h xi)], m = (h-1)/2;
  !! elliptical drives both with different factors; helical has xi = 0 and no
  !! on-axis harmonic coupling, which the brute force has to agree with too.
  @test
  subroutine testPlanarHarmonicsMatchBruteForce()
    call checkAgainstBruteForce("planepole", 1.0_wp, 1.0_wp, 1.0_wp, 3_ip)
    call checkAgainstBruteForce("planepole", 1.0_wp, 1.0_wp, 0.996_wp, 3_ip)
    call checkAgainstBruteForce("planepole", 1.0_wp, 1.0_wp, 1.0_wp, 5_ip)
    call checkAgainstBruteForce("planepole", 1.0_wp, 1.0_wp, 1.004_wp, 5_ip)
  end subroutine testPlanarHarmonicsMatchBruteForce


  @test
  subroutine testVerticalPlanarHarmonicsMatchBruteForce()
    call checkAgainstBruteForce("", 1.0_wp, 0.0_wp, 1.0_wp, 3_ip)
    call checkAgainstBruteForce("", 1.0_wp, 0.0_wp, 1.004_wp, 5_ip)
  end subroutine testVerticalPlanarHarmonicsMatchBruteForce


  @test
  subroutine testEllipticalHarmonicsMatchBruteForce()
    call checkAgainstBruteForce("", 0.5_wp, 1.0_wp, 1.0_wp, 3_ip)
    call checkAgainstBruteForce("", 0.5_wp, 1.0_wp, 0.996_wp, 5_ip)
    call checkAgainstBruteForce("", 1.0_wp, 0.6_wp, 1.0_wp, 3_ip)
    call checkAgainstBruteForce("", 1.0_wp, 0.6_wp, 1.004_wp, 5_ip)
  end subroutine testEllipticalHarmonicsMatchBruteForce


  @test
  subroutine testHelicalHarmonicsMatchBruteForce()
    call checkAgainstBruteForce("helical", 1.0_wp, 1.0_wp, 1.0_wp, 3_ip)
    call checkAgainstBruteForce("helical", 1.0_wp, 1.0_wp, 1.004_wp, 5_ip)
    call checkAgainstBruteForce("", -1.0_wp, 1.0_wp, 1.0_wp, 3_ip)
  end subroutine testHelicalHarmonicsMatchBruteForce


  !> For planepole the harmonic Bessel factors must reduce to the textbook
  !! JJ_h = J_m(h xi) - J_(m+1)(h xi), xi = K^2/(4 + 2K^2), up to the (-1)^m
  !! sign, and the harmonic couplings must not be trivially small - the
  !! brute-force checks above would pass a band that was zero everywhere for
  !! helical only.
  @test
  subroutine testPlanarHarmonicJJIsTextbook()
    type(tUndulator) :: und
    type(tFELFrame) :: frame
    type(tAvgCoupling) :: cpl
    real(kind=wp) :: xi, onePlusEtaP2, jjX, jjY
    integer(kind=ip) :: h

    call makeUnd(und, frame, "planepole", 1.0_wp, 1.0_wp)
    call getAvgCoupling(1.0_wp, und, frame, cpl)

    xi = frame%aw**2 / (4.0_wp + 2.0_wp * frame%aw**2)
    onePlusEtaP2 = 1.0_wp + frame%eta

    h = 3_ip
    call avgJJh(cpl, h, onePlusEtaP2, 1.0_wp, jjX, jjY)
    @assertEqual(-(bessel_jn(1, 3.0_wp * xi) - bessel_jn(2, 3.0_wp * xi)), jjX, 1.0e-4_wp)
    @assertTrue(abs(jjX) > 0.15_wp)

    h = 5_ip
    call avgJJh(cpl, h, onePlusEtaP2, 1.0_wp, jjX, jjY)
    @assertEqual(bessel_jn(2, 5.0_wp * xi) - bessel_jn(3, 5.0_wp * xi), jjX, 1.0e-4_wp)
    @assertTrue(abs(jjX) > 0.05_wp)

  end subroutine testPlanarHarmonicJJIsTextbook


  !> Asking for harmonic bands must leave the fundamental exactly as it was:
  !! getResonantMomentum's columns 1 and 2 bit for bit, and avgJJh at h = 1
  !! equal to avgJJ (to round-off, since bessel_jn and bessel_j0/j1 are
  !! different routines, which is why the fundamental keeps avgJJ).  And the
  !! band layout puts the fundamental first and the rest in ascending order.
  @test
  subroutine testHarmonicsLeaveFundamental()
    type(tUndulator) :: und
    type(tFELFrame) :: frame
    type(tAvgCoupling) :: cpl
    real(kind=wp), dimension(3) :: sz2, sgam, sp2
    real(kind=wp) :: qr(3,2), qi(3,2), qrH(3,6), qiH(3,6)
    real(kind=wp) :: jx, jy, jxh, jyh
    integer(kind=ip), allocatable :: bands(:)
    integer(kind=ip) :: harmIn(8)
    character(len=9), parameter :: types(3) = ["planepole", "helical  ", "         "]
    integer :: k

    sz2 = [0.11_wp, 0.52_wp, 0.93_wp]
    sgam = [1.0_wp, 1.003_wp, 0.996_wp]
    sp2 = [1.0_wp, 0.98_wp, 1.01_wp]

    do k = 1, 3

      call makeUnd(und, frame, trim(types(k)), 0.5_wp, 1.0_wp)
      call getAvgCoupling(0.4_wp, und, frame, cpl)

      call getResonantMomentum(0.4_wp, sz2, sgam, sp2, frame%eta, frame%rho, cpl, qr, qi)
      call getResonantMomentum(0.4_wp, sz2, sgam, sp2, frame%eta, frame%rho, cpl, &
                               qrH, qiH, [1_ip, 3_ip, 5_ip])

      @assertEqual(0.0_wp, maxval(abs(qrH(:,1:2) - qr)), 0.0_wp)
      @assertEqual(0.0_wp, maxval(abs(qiH(:,1:2) - qi)), 0.0_wp)

      call avgJJ(cpl, 1.02_wp, 0.99_wp, jx, jy)
      call avgJJh(cpl, 1_ip, 1.02_wp, 0.99_wp, jxh, jyh)
      @assertEqual(jx, jxh, 1.0e-15_wp)
      @assertEqual(jy, jyh, 1.0e-15_wp)

      if (k == 2) then

!       Helical: no on-axis harmonic coupling, exactly

        @assertEqual(0.0_wp, maxval(abs(qrH(:,3:6))), 0.0_wp)
        @assertEqual(0.0_wp, maxval(abs(qiH(:,3:6))), 0.0_wp)

      else

        @assertTrue(maxval(abs(qrH(:,3:6))) > 0.01_wp)

      end if

    end do

    harmIn = 0_ip
    call getAvgBands(harmIn, bands)
    @assertEqual(1, size(bands))
    @assertEqual(1, bands(1))

    harmIn(2) = 5_ip
    harmIn(5) = 3_ip
    harmIn(6) = 9_ip
    call getAvgBands(harmIn, bands)
    @assertEqual(4, size(bands))
    @assertEqual([1, 3, 5, 9], bands)

  end subroutine testHarmonicsLeaveFundamental


  !> For planepole JJ must reduce to the textbook J0(xi) - J1(xi) with
  !! xi = K^2/(4 + 2K^2), K the peak undulator parameter.  They differ only
  !! through O(eta) terms in the exact resonance condition.
  @test
  subroutine testPlanarJJIsTextbook()
    type(tUndulator) :: und
    type(tFELFrame) :: frame
    type(tAvgCoupling) :: cpl
    real(kind=wp) :: xi

    call makeUnd(und, frame, "planepole", 1.0_wp, 1.0_wp)
    call getAvgCoupling(1.0_wp, und, frame, cpl)

    xi = frame%aw**2 / (4.0_wp + 2.0_wp * frame%aw**2)

    @assertEqual(bessel_j0(xi) - bessel_j1(xi), cpl%jjRef, 1.0e-4_wp)
    @assertEqual(0.5_wp, cpl%pqSq, 1.0e-14_wp)
    @assertEqual(sqrt(0.5_wp), cpl%ampX, 1.0e-14_wp)
    @assertEqual(0.0_wp, cpl%ampY, 0.0_wp)

    call makeUnd(und, frame, "helical", 1.0_wp, 1.0_wp)
    call getAvgCoupling(1.0_wp, und, frame, cpl)

    @assertEqual(1.0_wp, cpl%jjRef, 1.0e-14_wp)
    @assertEqual(sqrt(0.5_wp), cpl%ampX, 1.0e-14_wp)
    @assertEqual(sqrt(0.5_wp), cpl%ampY, 1.0e-14_wp)
    @assertEqual(0.0_wp, cpl%xiCoef, 0.0_wp)

  end subroutine testPlanarJJIsTextbook


  !> The averaged natural focusing has to reproduce the betatron wavenumbers
  !! the unaveraged solver has - the sKBetaX_G / sKBetaY_G that calcScaling
  !! derives from the same undulator field.  Helical focuses equally in both
  !! planes at kappa/sqrt(2); a plane-pole undulator focuses only in y, at the
  !! same strength; and canting the poles (the curved type) splits that
  !! equally, kappa/2 in each plane, by moving focusing out of y and into x.
  @test
  subroutine testAvgFocusingMatchesKBeta()
    type(tUndulator) :: und
    type(tFELFrame) :: frame
    real(kind=wp) :: kbxSq, kbySq, kapSq, tol

    call makeUnd(und, frame, "helical", 1.0_wp, 1.0_wp)
    kapSq = frame%kappa**2
    tol = 1.0e-12_wp * kapSq

    call kBetaSqFromFocus(und, frame, .false., kbxSq, kbySq)
    @assertEqual(kapSq / 2.0_wp, kbxSq, tol)
    @assertEqual(kapSq / 2.0_wp, kbySq, tol)

    call makeUnd(und, frame, "planepole", 1.0_wp, 1.0_wp)
    kapSq = frame%kappa**2
    tol = 1.0e-12_wp * kapSq

    call kBetaSqFromFocus(und, frame, .false., kbxSq, kbySq)
    @assertEqual(0.0_wp, kbxSq, tol)
    @assertEqual(kapSq / 2.0_wp, kbySq, tol)

    call makeUnd(und, frame, "curved", 1.0_wp, 1.0_wp)
    kapSq = frame%kappa**2
    tol = 1.0e-12_wp * kapSq

    call kBetaSqFromFocus(und, frame, .false., kbxSq, kbySq)
    @assertEqual(kapSq / 4.0_wp, kbxSq, tol)
    @assertEqual(kapSq / 4.0_wp, kbySq, tol)

!   Focusing is quadratic in the undulator field, so the taper carries through
!   squared, and the end ramps switch it off with the coupling.

    call makeUnd(und, frame, "helical", 1.0_wp, 1.0_wp)
    und%n2col = 0.5_wp
    und%n2col_initial = 0.5_wp
    kapSq = frame%kappa**2

    call kBetaSqFromFocus(und, frame, .false., kbxSq, kbySq)
    @assertEqual(0.25_wp * kapSq / 2.0_wp, kbxSq, 1.0e-12_wp * kapSq)

  end subroutine testAvgFocusingMatchesKBeta


  !> The non-physical strong-focusing channel is already slow, so averaged mode
  !! carries it unchanged: it must give back exactly the kbetax_SF, kbetay_SF
  !! that were asked for, on top of the natural focusing.
  @test
  subroutine testAvgFocusingStrongChannel()
    type(tUndulator) :: und
    type(tFELFrame) :: frame
    real(kind=wp) :: kbxSq, kbySq, kapSq, sfx, sfy

    call makeUnd(und, frame, "planepole", 1.0_wp, 1.0_wp)
    kapSq = frame%kappa**2

    sfx = 0.3_wp * frame%kappa
    sfy = 0.7_wp * frame%kappa
    und%k_beta_x_sf = sfx
    und%k_beta_y_sf = sfy

!   Off, the channel contributes nothing

    call kBetaSqFromFocus(und, frame, .false., kbxSq, kbySq)
    @assertEqual(0.0_wp, kbxSq, 1.0e-12_wp * kapSq)

    call kBetaSqFromFocus(und, frame, .true., kbxSq, kbySq)
    @assertEqual(sfx**2, kbxSq, 1.0e-12_wp * kapSq)
    @assertEqual(kapSq / 2.0_wp + sfy**2, kbySq, 1.0e-12_wp * kapSq)

  end subroutine testAvgFocusingStrongChannel


  !> getAvgFocusing has to apply those coefficients with the right sign in each
  !! plane.  spi is -py and dy/dz goes as -spi, so a focusing y needs a
  !! positive sdpi where a focusing x needs a negative sdpr.
  @test
  subroutine testAvgFocusingSigns()
    type(tUndulator) :: und
    type(tFELFrame) :: frame
    type(tAvgFocusing) :: foc
    integer, parameter :: ne = 3
    real(kind=wp), dimension(ne) :: sx, sy, sgam, sp2, sdpr, sdpi
    integer :: j

    call makeUnd(und, frame, "helical", 1.0_wp, 1.0_wp)
    call getAvgFocusCoef(0.5_wp, und, frame, .false., foc)

    sx = [0.4_wp, -0.2_wp, 0.0_wp]
    sy = [-0.3_wp, 0.5_wp, 0.0_wp]
    sgam = [1.0_wp, 1.1_wp, 0.9_wp]
    sp2 = [1.0_wp, 0.8_wp, 1.2_wp]

    call getAvgFocusing(sx, sy, sgam, sp2, frame%eta, foc, sdpr, sdpi)

    do j = 1, 2
      @assertTrue(sdpr(j) * sx(j) < 0.0_wp)
      @assertTrue(sdpi(j) * sy(j) > 0.0_wp)
    end do

!   On axis, no force

    @assertEqual(0.0_wp, sdpr(3), 0.0_wp)
    @assertEqual(0.0_wp, sdpi(3), 0.0_wp)

!   And it scales as (1 + eta p2)/Gamma per particle

    @assertEqual(-foc%cNatX * (1.0_wp + frame%eta * sp2(1)) / sgam(1) * sx(1), &
                 sdpr(1), 1.0e-14_wp * abs(sdpr(1)))

  end subroutine testAvgFocusingSigns


  !> The stored envelope sits on the exp(-i z2/2rho) carrier, so a mode at
  !! envelope kz2 is physically at kz2 - 1/2rho, and the envelope's own kz2 = 0
  !! mode is the carrier itself.
  @test
  subroutine testCarrierOffset()
    @assertEqual(-100.0_wp, getAvgCarrierKz2(0.005_wp, 1_ip), 1.0e-12_wp)
    @assertEqual(-300.0_wp, getAvgCarrierKz2(0.005_wp, 3_ip), 1.0e-12_wp)
    @assertEqual(-500.0_wp, getAvgCarrierKz2(0.005_wp, 5_ip), 1.0e-12_wp)
  end subroutine testCarrierOffset


  !> The mode's guards.  These exist because the alternative is being silently
  !! wrong - a resolved field read into an envelope array, or a pperp that still
  !! carries the quiver, both look perfectly plausible and are not.  A guard
  !! that quietly stops firing is the same failure again, so each one is pinned
  !! here.
  @test
  subroutine testAveragedGuards()

    use Globals, only: qAveraged_G, sLambdarPerCell_G, iInputType_G, iGenHom_G, &
                       iReadH5_G, iReadMASP_G, iFieldSeedType_G, iSimpleSeed_G, &
                       iReadH5Field_G, iAvgHarmonics_G
    use checks, only: chkAveraged

    real(kind=wp) :: freqf(1), sSigE(1, 6), mag(1)
    logical :: qOK

    freqf = 1.0_wp
    sSigE = 0.0_wp
    mag = 0.0_wp

    iAvgHarmonics_G = 0_ip
    qAveraged_G = .true.
    sLambdarPerCell_G = 1.0_wp
    iInputType_G = iGenHom_G
    iFieldSeedType_G = iSimpleSeed_G

!   A plain setup passes - any undulator polarisation does

    call chkAveraged(.false., 64_ip, freqf, sSigE, mag, qOK)
    @assertTrue(qOK)

!   ...and every guard rejects on its own

    call chkAveraged(.true., 64_ip, freqf, sSigE, mag, qOK)
    @assertFalse(qOK)

!   A tiny z2 mesh only warns - it is the one way to model a single periodic
!   cycle, and on few enough ranks it runs.

    call chkAveraged(.false., 2_ip, freqf, sSigE, mag, qOK)
    @assertTrue(qOK)

    iFieldSeedType_G = iReadH5Field_G
    call chkAveraged(.false., 64_ip, freqf, sSigE, mag, qOK)
    @assertFalse(qOK)
    iFieldSeedType_G = iSimpleSeed_G

    iInputType_G = iReadH5_G
    call chkAveraged(.false., 64_ip, freqf, sSigE, mag, qOK)
    @assertFalse(qOK)

    iInputType_G = iReadMASP_G
    call chkAveraged(.false., 64_ip, freqf, sSigE, mag, qOK)
    @assertFalse(qOK)
    iInputType_G = iGenHom_G

!   lambdarPerCell must be positive, and sets the band

    sLambdarPerCell_G = 0.0_wp
    call chkAveraged(.false., 64_ip, freqf, sSigE, mag, qOK)
    @assertFalse(qOK)

!   Band is 1 +/- 1/(2 lambdarPerCell): at 4 cells per wavelength that is
!   +/- 0.125, so a seed at 1.3 is out and one at 1.1 is in.

    sLambdarPerCell_G = 4.0_wp

    freqf = 1.3_wp
    call chkAveraged(.false., 64_ip, freqf, sSigE, mag, qOK)
    @assertFalse(qOK)

    freqf = 1.1_wp
    call chkAveraged(.false., 64_ip, freqf, sSigE, mag, qOK)
    @assertTrue(qOK)

!   And none of it applies when the mode is off

    freqf = 1.3_wp
    qAveraged_G = .false.
    call chkAveraged(.true., 2_ip, freqf, sSigE, mag, qOK)
    @assertTrue(qOK)

    sLambdarPerCell_G = 1.0_wp

  end subroutine testAveragedGuards


  !> avgHarmonics: distinct odd harmonics of 3 or more, in any order, and
  !! only with the mode on.  Each wrong form is rejected on its own.
  @test
  subroutine testAveragedHarmonicGuards()

    use Globals, only: qAveraged_G, sLambdarPerCell_G, iInputType_G, iGenHom_G, &
                       iFieldSeedType_G, iSimpleSeed_G, iAvgHarmonics_G
    use checks, only: chkAveraged

    real(kind=wp) :: freqf(1), sSigE(1, 6), mag(1)
    logical :: qOK

    freqf = 1.0_wp
    sSigE = 0.0_wp
    mag = 0.0_wp

    qAveraged_G = .true.
    sLambdarPerCell_G = 1.0_wp
    iInputType_G = iGenHom_G
    iFieldSeedType_G = iSimpleSeed_G

!   Valid: none, the 3rd and 5th in either order, unused entries anywhere

    iAvgHarmonics_G = 0_ip
    call chkAveraged(.false., 64_ip, freqf, sSigE, mag, qOK)
    @assertTrue(qOK)

    iAvgHarmonics_G(1:2) = [3_ip, 5_ip]
    call chkAveraged(.false., 64_ip, freqf, sSigE, mag, qOK)
    @assertTrue(qOK)

    iAvgHarmonics_G = 0_ip
    iAvgHarmonics_G(2) = 5_ip
    iAvgHarmonics_G(4) = 3_ip
    call chkAveraged(.false., 64_ip, freqf, sSigE, mag, qOK)
    @assertTrue(qOK)

!   Even

    iAvgHarmonics_G = 0_ip
    iAvgHarmonics_G(1:2) = [3_ip, 4_ip]
    call chkAveraged(.false., 64_ip, freqf, sSigE, mag, qOK)
    @assertFalse(qOK)

!   Below 3: the fundamental itself, and nonsense

    iAvgHarmonics_G(1:2) = [1_ip, 3_ip]
    call chkAveraged(.false., 64_ip, freqf, sSigE, mag, qOK)
    @assertFalse(qOK)

    iAvgHarmonics_G(1:2) = [-3_ip, 5_ip]
    call chkAveraged(.false., 64_ip, freqf, sSigE, mag, qOK)
    @assertFalse(qOK)

!   Duplicates

    iAvgHarmonics_G(1:3) = [3_ip, 5_ip, 3_ip]
    call chkAveraged(.false., 64_ip, freqf, sSigE, mag, qOK)
    @assertFalse(qOK)

!   Valid harmonics, but the mode is off

    iAvgHarmonics_G = 0_ip
    iAvgHarmonics_G(1:2) = [3_ip, 5_ip]
    qAveraged_G = .false.
    call chkAveraged(.false., 64_ip, freqf, sSigE, mag, qOK)
    @assertFalse(qOK)

    iAvgHarmonics_G = 0_ip
    call chkAveraged(.false., 64_ip, freqf, sSigE, mag, qOK)
    @assertTrue(qOK)

  end subroutine testAveragedHarmonicGuards


  !> Coupling ramps linearly over the 2-period end sections, as the by field does.
  @test
  subroutine testEnvelopeRamps()
    type(tUndulator) :: und
    type(tFELFrame) :: frame
    real(kind=wp) :: ramp

    call makeUnd(und, frame, "planepole", 1.0_wp, 1.0_wp)
    ramp = 8.0_wp * pi * frame%rho

    @assertEqual(1.0_wp, getAvgEnvelope(0.01_wp, und, frame), 1e-14_wp)

    und%model_undulator_ends = .true.
    und%z_start_undulator = ramp
    und%z_end_undulator = 1.0_wp

    @assertEqual(0.25_wp, getAvgEnvelope(0.25_wp * ramp, und, frame), 1e-14_wp)
    @assertEqual(1.0_wp, getAvgEnvelope(0.5_wp, und, frame), 1e-14_wp)
    @assertEqual(0.75_wp, getAvgEnvelope(1.0_wp + 0.25_wp * ramp, und, frame), 1e-14_wp)
    @assertEqual(0.0_wp, getAvgEnvelope(1.0_wp + 2.0_wp * ramp, und, frame), 1e-14_wp)

  end subroutine testEnvelopeRamps


  !> One RHS evaluation of the averaged 1D system, with the real getrhs.  In
  !! scaled units the field energy is sum_nodes |A|^2 dV3 and the beam energy
  !! sum_j chi_j Gamma_j / (2 rho), so
  !!
  !!     sum_nodes (Ar dAr/dz + Ai dAi/dz) dV3 + sum_j chi_j dGamma_j/dz / (2 rho) = 0
  !!
  !! holds exactly for the discrete system: linear interpolation and linear
  !! deposition share their weights, and the source and the energy equation
  !! share q_c, for each of the two Cartesian envelopes.  The two are given
  !! unrelated fields, so a coupling that leaks between them shows up.
  !!
  !! With harm, the field carries harmonic bands as well, [1, harm], every
  !! component with its own unrelated field, and the balance is summed over
  !! all of them; the harmonic bands' own source is checked to be non-trivial
  !! wherever the undulator has on-axis harmonic coupling, and zero for helical.
  subroutine checkRhsEnergyBalance(undType, fx, fy, grad, qEnds, sZ, qOneD, harm)

    use Globals, only: sLengthOfElmX_G, sLengthOfElmY_G, sLengthOfElmZ2_G, NX_G, NY_G, &
                       NZ2_G, nspinDX, nspinDY, ntrndsi_G, fieldMesh, iTemporal, &
                       qElectronsEvolve_G, qFieldEvolve_G, qElectronFieldCoupling_G, &
                       iNumberElectrons_G, procelectrons_G, s_chi_bar_G, dadz_w
    use ParaField, only: tTransInfo_G
    use rhs, only: getrhs

    character(*), intent(in) :: undType
    real(kind=wp), intent(in) :: fx, fy, grad, sZ
    logical, intent(in) :: qEnds, qOneD
    integer(kind=ip), intent(in), optional :: harm(:)

    type(tSimulationContext) :: ctx
    integer, parameter :: ne = 7, nz = 16, ntr = 25
    real(kind=wp), allocatable :: sAr(:,:), sAi(:,:), dAr(:,:), dAi(:,:)   ! (node, envelope)
    real(kind=wp), dimension(ne) :: sx, sy, sz2, spr, spi, sgam, &
                                    sdx, sdy, sdz2, sdpr, sdpi, sdgam
    real(kind=wp) :: dz2v, dxv, dyv, dV3v, fieldRate, beamRate, harmSrc
    integer :: nf, nc
    logical :: qOK
    integer :: j, ic

    call makeUnd(ctx%und, ctx%frame, undType, fx, fy)
    ctx%und%undulator_gradient = grad
    ctx%und%model_undulator_ends = qEnds
    if (qEnds) then
      ctx%und%z_start_undulator = 8.0_wp * pi * ctx%frame%rho
      ctx%und%z_end_undulator = 1.0_wp
    end if

    ctx%flags%period_averaged = .true.
    ctx%flags%parallel_arrays_ok = .true.
    ctx%flags%inner_xy_ok = .true.

!   An envelope mesh 1.5 resonant wavelengths per cell.  In 3D, a 5x5
!   transverse inner mesh alongside it, with the macroparticles well inside.

    dz2v = 1.5_wp * 4.0_wp * pi * ctx%frame%rho

    if (qOneD) then
      dxv = 1.0_wp
      dyv = 1.0_wp
      nspinDX = 1
      nspinDY = 1
      NX_G = 1
      NY_G = 1
      ntrndsi_G = 1
    else
      dxv = 0.4_wp
      dyv = 0.4_wp
      nspinDX = 5
      nspinDY = 5
      NX_G = 5
      NY_G = 5
      ntrndsi_G = ntr
    end if

    sLengthOfElmX_G = dxv
    sLengthOfElmY_G = dyv
    sLengthOfElmZ2_G = dz2v
    dV3v = dxv * dyv * dz2v
    NZ2_G = nz
    fieldMesh = iTemporal
    tTransInfo_G%qOneD = qOneD
    ctx%field%fz2 = 1
    ctx%field%bz2 = nz

    nf = ntrndsi_G * nz
    nc = 2
    if (present(harm)) then
      ctx%field%bandHarm = [1_ip, harm]
      nc = 2 * size(ctx%field%bandHarm)
    end if
    ctx%field%nComp = nc
    ctx%field%nEnv = nc
    allocate(sAr(nf,nc), sAi(nf,nc), dAr(nf,nc), dAi(nf,nc))

    qElectronsEvolve_G = .true.
    qFieldEvolve_G = .true.
    qElectronFieldCoupling_G = .true.

    iNumberElectrons_G = ne

!   A failed assertion returns from the test before the deallocate below, so
!   clear these first rather than letting the next test die on re-allocation.

    if (allocated(procelectrons_G)) deallocate(procelectrons_G)
    if (allocated(s_chi_bar_G)) deallocate(s_chi_bar_G)
    if (allocated(dadz_w)) deallocate(dadz_w)

    allocate(procelectrons_G(1), s_chi_bar_G(ne), dadz_w(ne))
    procelectrons_G(1) = ne

    do j = 1, ne
      s_chi_bar_G(j) = 0.8_wp + 0.05_wp * j
      sz2(j) = dz2v * (0.37_wp + 1.9_wp * j)
      sgam(j) = 1.0_wp + 0.01_wp * sin(real(j, kind=wp))
      spr(j) = 0.01_wp * cos(real(j, kind=wp))
      spi(j) = -0.02_wp * sin(real(j, kind=wp))
    end do

    sx = 0.0_wp
    sy = 0.0_wp

    if (.not. qOneD) then
      do j = 1, ne
        sx(j) = 0.35_wp * cos(0.9_wp * j)
        sy(j) = 0.35_wp * sin(1.3_wp * j)
      end do
    end if

    do j = 1, nf
      sAr(j,1) = 0.1_wp * cos(0.7_wp * j)
      sAi(j,1) = 0.1_wp * sin(0.3_wp * j + 1.0_wp)
      sAr(j,2) = 0.07_wp * sin(1.1_wp * j + 0.2_wp)
      sAi(j,2) = -0.12_wp * cos(0.5_wp * j)
      do ic = 3, nc
        sAr(j,ic) = 0.05_wp * cos(0.4_wp * ic * j + 0.3_wp * ic)
        sAi(j,ic) = 0.06_wp * sin(0.9_wp * j - 0.7_wp * ic)
      end do
    end do

    dAr = 0.0_wp
    dAi = 0.0_wp
    sdx = 0.0_wp; sdy = 0.0_wp; sdz2 = 0.0_wp
    sdpr = 0.0_wp; sdpi = 0.0_wp; sdgam = 0.0_wp

    call getrhs(sZ, sAr, sAi, sx, sy, sz2, spr, spi, sgam, &
                sdx, sdy, sdz2, sdpr, sdpi, sdgam, dAr, dAi, qOK, ctx)

    @assertTrue(qOK)

!   sum over the whole rank-2 array, so this is the balance summed over both
!   envelopes.

    fieldRate = sum(sAr * dAr + sAi * dAi) * dV3v
    beamRate = sum(s_chi_bar_G * sdgam) / (2.0_wp * ctx%frame%rho)

!   Non-trivial, and balanced to round-off

    @assertTrue(abs(fieldRate) > 1.0e-4_wp)
    @assertEqual(0.0_wp, fieldRate + beamRate, 1.0e-13_wp * (abs(fieldRate) + abs(beamRate)))

!   The harmonic bands' source has to be there - measured on the source
!   itself, since its exchange with an arbitrary field can cancel by accident.

    if (nc > 2) then
      harmSrc = sum(abs(dAr(:,3:)) + abs(dAi(:,3:)))
      if (undType == "helical") then
        @assertEqual(0.0_wp, harmSrc, 0.0_wp)
      else
        @assertTrue(harmSrc > 1.0e-2_wp * sum(abs(dAr(:,1:2)) + abs(dAi(:,1:2))))
      end if
    end if

    if (qOneD) then

!     pperp holds only its slow part, and in 1D nothing drives it

      @assertEqual(0.0_wp, maxval(abs(sdpr)), 0.0_wp)
      @assertEqual(0.0_wp, maxval(abs(sdpi)), 0.0_wp)

    else

!     In 3D the averaged natural focusing does, and it does no work on the
!     field - the balance above still holds exactly.  Every type here focuses
!     in y; only a plane-pole undulator has no focusing in x, and there sdpr
!     is identically zero rather than merely small.

      @assertTrue(maxval(abs(sdpi)) > 0.0_wp)

      if (undType == "planepole") then
        @assertEqual(0.0_wp, maxval(abs(sdpr)), 0.0_wp)
      else
        @assertTrue(maxval(abs(sdpr)) > 0.0_wp)
      end if

      do j = 1, ne
        @assertTrue(sdpr(j) * sx(j) <= 0.0_wp)
        @assertTrue(sdpi(j) * sy(j) >= 0.0_wp)
      end do

    end if

    deallocate(sAr, sAi, dAr, dAi)
    deallocate(procelectrons_G, s_chi_bar_G, dadz_w)

  end subroutine checkRhsEnergyBalance


  @test
  subroutine testRhsConservesEnergyHelical()
    call checkRhsEnergyBalance("helical", 1.0_wp, 1.0_wp, 0.0_wp, .false., 0.37_wp, .true.)
  end subroutine testRhsConservesEnergyHelical


  @test
  subroutine testRhsConservesEnergyPlanepole()
    call checkRhsEnergyBalance("planepole", 1.0_wp, 1.0_wp, 0.0_wp, .false., 0.37_wp, .true.)
  end subroutine testRhsConservesEnergyPlanepole


  !> Taper and end ramp change alpha - it has to change in both equations at once.
  @test
  subroutine testRhsConservesEnergyTaperedRamp()
    call checkRhsEnergyBalance("planepole", 1.0_wp, 1.0_wp, -0.05_wp, .true., 0.05_wp, .true.)
    call checkRhsEnergyBalance("planepole", 1.0_wp, 1.0_wp, -0.05_wp, .true., 0.6_wp, .true.)
  end subroutine testRhsConservesEnergyTaperedRamp


  !> The same balance through the 3D path - getInterps_3D, getFFelecs_3D and
  !! getSource_3D - where the averaged focusing is also live.  Beam and field
  !! still have to balance exactly: focusing moves transverse momentum, not
  !! energy.
  @test
  subroutine testRhsConservesEnergy3DHelical()
    call checkRhsEnergyBalance("helical", 1.0_wp, 1.0_wp, 0.0_wp, .false., 0.37_wp, .false.)
  end subroutine testRhsConservesEnergy3DHelical


  @test
  subroutine testRhsConservesEnergy3DPlanepole()
    call checkRhsEnergyBalance("planepole", 1.0_wp, 1.0_wp, 0.0_wp, .false., 0.37_wp, .false.)
  end subroutine testRhsConservesEnergy3DPlanepole


  @test
  subroutine testRhsConservesEnergy3DCurved()
    call checkRhsEnergyBalance("curved", 1.0_wp, 1.0_wp, 0.0_wp, .false., 0.37_wp, .false.)
  end subroutine testRhsConservesEnergy3DCurved


  !> Elliptical and linear-along-y undulators, which drive both envelopes or
  !! the second alone, in 1D and through the 3D path.
  @test
  subroutine testRhsConservesEnergyElliptical()
    call checkRhsEnergyBalance("", 0.5_wp, 1.0_wp, 0.0_wp, .false., 0.37_wp, .true.)
    call checkRhsEnergyBalance("", 1.0_wp, 0.6_wp, -0.05_wp, .true., 0.6_wp, .true.)
    call checkRhsEnergyBalance("", 1.0_wp, 0.0_wp, 0.0_wp, .false., 0.37_wp, .true.)
  end subroutine testRhsConservesEnergyElliptical


  @test
  subroutine testRhsConservesEnergy3DElliptical()
    call checkRhsEnergyBalance("", 0.5_wp, 1.0_wp, 0.0_wp, .false., 0.37_wp, .false.)
  end subroutine testRhsConservesEnergy3DElliptical


  !> Harmonic bands 3 and 5 alongside the fundamental, six components with
  !! unrelated fields: the balance has to hold summed over all of them, in 1D
  !! and through the 3D path, with taper and ramps, for every polarisation.
  @test
  subroutine testRhsConservesEnergyHarmonics()
    call checkRhsEnergyBalance("planepole", 1.0_wp, 1.0_wp, 0.0_wp, .false., 0.37_wp, .true., &
                               [3_ip, 5_ip])
    call checkRhsEnergyBalance("planepole", 1.0_wp, 1.0_wp, -0.05_wp, .true., 0.05_wp, .true., &
                               [3_ip, 5_ip])
    call checkRhsEnergyBalance("", 0.5_wp, 1.0_wp, 0.0_wp, .false., 0.37_wp, .true., &
                               [5_ip, 3_ip])
    call checkRhsEnergyBalance("", 1.0_wp, 0.0_wp, -0.05_wp, .true., 0.6_wp, .true., &
                               [3_ip])
    call checkRhsEnergyBalance("helical", 1.0_wp, 1.0_wp, 0.0_wp, .false., 0.37_wp, .true., &
                               [3_ip, 5_ip])
  end subroutine testRhsConservesEnergyHarmonics


  @test
  subroutine testRhsConservesEnergy3DHarmonics()
    call checkRhsEnergyBalance("planepole", 1.0_wp, 1.0_wp, 0.0_wp, .false., 0.37_wp, .false., &
                               [3_ip, 5_ip])
    call checkRhsEnergyBalance("", 1.0_wp, 0.6_wp, 0.0_wp, .false., 0.37_wp, .false., &
                               [3_ip, 5_ip])
  end subroutine testRhsConservesEnergy3DHarmonics

end module testAveraging
