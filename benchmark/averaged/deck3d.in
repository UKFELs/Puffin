! Averaged-vs-unaveraged comparison deck, 3D (see README.md).
! Seeded, noise-free, single undulator, no lattice file, no undulator ends:
! everything that could add run-to-run variance is off, so the only thing
! that changes between runs is what run_compare3d.py sets: the solver mode,
! mesh, step, undulator type and aw.
!
! Same FEL parameters as the 1D deck.in - rho = 0.005, aw = 1.012,
! gamma_r = 456.4 - with a transverse mesh, diffraction, natural focusing and
! a matched beam.  Ipk is well above the 1D deck's so that 120 periods reach
! clear exponential growth (power x29) rather than seed-dominated lethargy.
!
! sBeta = 0 deliberately.  The z2 absorbing boundary is sized in NODES
! (NBZ2_G = 37, setup_calcs.f90), which is ~1.7% of an unaveraged z2 mesh but
! ~18% of a lambdarPerCell = 1 envelope mesh of the same length, so a nonzero
! sBeta would absorb ~10x more of the averaged run's field and the comparison
! would be measuring that rather than the physics.  See the W2 and W7 notes in
! AVERAGED_MODE_ROADMAP.md.

&MDATA
 qOneD                  = .false.
 qFieldEvolve           = .true.
 qElectronsEvolve       = .true.
 qElectronFieldCoupling = .true.
 qFocussing             = .false.
 qDiffraction           = .true.
 qFilter                = .true.
 q_noise                = .false.
 qUndEnds               = .false.
 beam_file              = 'beam_file.in'
 sElectronThreshold     = 0.05
 iNumNodesX             = 41
 iNumNodesY             = 41
 nodesPerLambdar        = 12
 sFModelLengthX         = 8.0
 sFModelLengthY         = 8.0
 sFModelLengthZ2        = 2.0
 iRedNodesX             = 21
 iRedNodesY             = 21
 sFiltFrac              = 0.3
 sDiffFrac              = 1.0
 sBeta                  = 0.0
 seed_file              = 'seed_file.in'
 srho                   = 0.005
 sux                    = 1.0
 suy                    = 1.0
 saw                    = 1.0121809
 sgamma_r               = 456.40
 lambda_w               = 0.0275
 Dfact                  = 0.0
 zundType               = 'helical'
 taper                  = 0.0
 lattFile               = ''
 stepsPerPeriod         = 30
 nPeriods               = 120
 sZ0                    = 0.0
 iWriteNthSteps         = 1000000
 iWriteIntNthSteps      = 1000000
 sPEOut                 = 0.0
 /
