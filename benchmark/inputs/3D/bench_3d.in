!!!!!!!!!!!!!!  CLARA 3D performance benchmark deck  !!!!!!!!!!!!!!
!!
!!  233MeV beam, lasing @ 100nm.  Single undulator module, no lattice file.
!!
!!  Derived from test/inputs/3D/clara_test.in, scaled up so a run takes
!!  several seconds.  Relative to the test deck:
!!
!!    nPeriods        5  -> 300   (60x more RK4 steps)
!!    write cadence   60 -> 1200 field / 30 -> 600 integrated
!!
!!  Mesh, beam and physics are otherwise identical to the test deck, and the
!!  beam is still read from the committed HDF5 file so shot noise is fixed and
!!  the run is deterministic.
!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

&MDATA
 qScaled                = .false.
 qOneD                  = .false.
 qFieldEvolve           = .true.
 qElectronsEvolve       = .true.
 qElectronFieldCoupling = .true.
 qFocussing             = .false.
 qDiffraction           = .true.
 qUndEnds               = .true.
 qFMesh_G               = .false.
 beam_file              = 'inputs/3D/beam_file_h5.in'
 meshType               = 1
 sElectronThreshold     = 0.05
 iNumNodesX             = 85
 iNumNodesY             = 85
 nodesPerLambdar        = 21
 sFModelLengthX         = 0.003335537906783215
 sFModelLengthY         = 0.003335537906783215
 sFModelLengthZ2        = 3.329781820520314e-16
 sperwaves              = 1.0
 iRedNodesX             = 21
 iRedNodesY             = 21
 sFiltFrac              = 0.3
 sDiffFrac              = 1.0
 sBeta                  = 1.0
 seed_file              = 'inputs/3D/seed_file.in'
 srho                   = 0.005
 saw                    = 1.0121809
 sgamma_r               = 456.40
 lambda_w               = 0.0275
 zundType               = 'planepole'
 stepsPerPeriod         = 30
 nPeriods               = 300
 sZ0                    = 0.0
 iWriteNthSteps         = 1200
 iWriteIntNthSteps      = 600
 sRedistLen             = 0.25
 iRedistStp             = 10
 /
